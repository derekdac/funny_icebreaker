# Local development fallback when Secret Manager is not configured.
# Never commit real keys.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
COLDOPEN_USE_SECRET_MANAGER=false
GOOGLE_API_KEY=
COLDOPEN_DB_PATH=coldopen_state.db
COLDOPEN_ENABLE_CLOUD_DLP=false
COLDOPEN_MODEL_PRO=gemini-3.1-pro-preview
COLDOPEN_MODEL_FLASH=gemini-3.8-flash
